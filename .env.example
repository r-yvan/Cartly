# PostgreSQL connection string. On Vercel this must be a hosted database
# (Neon, Supabase, Vercel Postgres…), not localhost.
DATABASE_URL="postgresql://user:password@host:5432/cartly"

# The site's public URL. http://localhost:3000 locally; on Vercel set it to
# your production domain, e.g. https://cartly.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional GitHub OAuth. Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
